{
  "name": "ecovit",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:test": "node --env-file=.env.test --import tsx server/test-main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "format": "prettier --write src tests *.json *.ts *.js",
    "api:dev": "node --env-file=.env --import tsx server/main.ts",
    "api:start": "node --env-file=.env dist-server/main.mjs",
    "db:migrate": "node --env-file=.env --import tsx server/cli.ts migrate",
    "data:cleanup": "node --env-file=.env --import tsx server/cli.ts cleanup"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "konva": "^10.0.0",
    "lucide-react": "1.57.0",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.0",
    "sharp": "0.35.5",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.4",
    "dexie": "^4.0.0"
  }
}
