# Copy to .env locally; never commit actual credentials.
APP_ORIGIN=http://127.0.0.1:5173
# Optional local development sign-in without an email code.
# DEV_LOGIN_EMAIL=you@example.com
API_PORT=3001
DATABASE_URL=postgresql://ecovit:CHANGE_ME@127.0.0.1:5432/ecovit
# Required for db:migrate and CD; keep the real value only in the private .env.
# Only migration command connects as owner; runtime uses DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://ecovit_owner:CHANGE_ME@127.0.0.1:5432/ecovit
SESSION_SECRET=
DATA_DIR=.data/ecovit
RESEND_API_KEY=
MAIL_FROM=Ecovit <ecovit@idevs.com.br>
PROJECT_LIMIT=20
IMAGE_LIMIT=524288000
VALIDATION_TIMEOUT_MS=90000
